          "mode": "name",
          "value": "={{ $('Configure your market').item.json.data_table }}"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "domain",
              "keyValue": "={{ $json.domain }}"
            }
          ]
        }
      },
      "id": "b1000000-0000-4000-8000-000000000015",
      "name": "Keep startups not saved yet",
