{
	"name": "@alion-io/n8n-nodes-alion",
	"version": "0.1.0",
	"description": "n8n node for Alion: companies, startups, investors, job postings and pay statistics in your workflows and AI agents. Free without a key for compact searches.",
	"license": "MIT",
	"homepage": "https://github.com/alion-io/n8n-nodes-alion#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"alion",
		"company data",
		"startups",
		"investors",
		"job postings",
		"salary data",
		"sales prospecting"
	],
	"author": {
		"name": "Alion",
		"email": "info@alion.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alion-io/n8n-nodes-alion.git"
	},
	"bugs": {
		"url": "https://github.com/alion-io/n8n-nodes-alion/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"generate": "node scripts/generate.mjs",
		"test": "node --test test/live.test.mjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AlionApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Alion/Alion.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
